{
  "name": "nsodod",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Le jardin du défi NoSugarOrDieOfDiabetes",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env scripts/serve.mjs",
