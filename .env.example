# Variables serveur Vercel (Settings > Environment Variables).
# Ne jamais mettre les vraies valeurs dans le dépôt ou firebase-config.js.
OPENAI_API_KEY=
# JSON complet du compte de service du projet nsod-od, en une seule variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Mot de passe personnel d'Abdennour, au moins 16 caractères.
ADMIN_PASSWORD=
